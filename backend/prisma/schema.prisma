// =============================================================================
// FitAI X – Prisma Database Schema Configuration
// Database Engine: PostgreSQL
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

