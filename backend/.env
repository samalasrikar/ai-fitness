# =============================================================================
# FitAI X Backend – Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ─── PostgreSQL (Prisma) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitaix_db?schema=public"

# Optional: Disable Prisma advisory locks (useful in CI environments)
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=true

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ─── Cookie ──────────────────────────────────────────────────────────────────
COOKIE_SECRET=your-cookie-secret-change-in-production

# ─── BullMQ ──────────────────────────────────────────────────────────────────
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379

# ─── AI (Future) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# ─── Storage (Future) ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
