dist/
build/
frontend/dist/
backend/dist/

# Environment files
.env
.env.local
*.env.local
backend/.env
frontend/.env
frontend/.env.local

# Logs
logs/
*.log

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
